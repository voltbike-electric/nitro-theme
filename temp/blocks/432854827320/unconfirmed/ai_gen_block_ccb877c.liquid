{% doc %}
  @prompt
    Create a customizable product information tabs block designed to be added inside the main Product Information section below the product price. Include tabs for product description, specifications, shipping, and warranty. Use the current product’s dynamic information where available, let the merchant edit tab labels and content in the theme editor, match the theme’s typography, colors, spacing, and mobile layout, and keep the interface accessible and easy to scan., Add icons above the tab title, i wan to be able to upload my own icon image, Remove Descriptions and Specifications tab, Add one more tab. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-tabs-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }};font-weight:{{ block.settings.body_font.weight }}}.ai-tabs-{{ ai_gen_id }}__nav{display:flex;overflow:auto;border-bottom:1px solid {{ block.settings.border_color }}}.ai-tabs-{{ ai_gen_id }}__tab{border:0;border-bottom:2px solid transparent;background:transparent;color:{{ block.settings.muted_text_color }};font:inherit;font-weight:600;min-height:72px;padding:10px 18px;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;white-space:nowrap}.ai-tabs-{{ ai_gen_id }}__tab[aria-selected=true]{border-color:{{ block.settings.accent_color }};color:{{ block.settings.text_color }}}.ai-tabs-{{ ai_gen_id }}__tab:focus-visible{outline:2px solid {{ block.settings.accent_color }}}.ai-tabs-{{ ai_gen_id }}__icon{width:22px;height:22px;object-fit:contain;display:inline-flex;align-items:center;justify-content:center}.ai-tabs-{{ ai_gen_id }}__panel{padding:20px 4px;font-size:{{ block.settings.body_size }}px;line-height:1.6}.ai-tabs-{{ ai_gen_id }}__panel[hidden]{display:none}@media(max-width:749px){.ai-tabs-{{ ai_gen_id }}{width:100%}.ai-tabs-{{ ai_gen_id }}__tab{padding:10px 14px;font-size:14px}}{% endstyle %}
<product-info-tabs-{{ ai_gen_id }} class="ai-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-tabs-{{ ai_gen_id }}__nav" role="tablist" aria-label="{{ block.settings.tabs_label | escape }}">{% for i in (1..3) %}{% assign label_key = 'tab_' | append: i | append: '_label' %}{% assign icon_key = 'tab_' | append: i | append: '_icon' %}{% assign image_key = 'tab_' | append: i | append: '_image' %}<button type="button" class="ai-tabs-{{ ai_gen_id }}__tab" role="tab" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}" aria-controls="ai-panel-{{ ai_gen_id }}-{{ i }}" tabindex="{% if i == 1 %}0{% else %}-1{% endif %}">{% if block.settings[image_key] %}<img class="ai-tabs-{{ ai_gen_id }}__icon" src="{{ block.settings[image_key] | image_url: width: 80 }}" alt="" width="22" height="22">{% else %}<span class="ai-tabs-{{ ai_gen_id }}__icon" aria-hidden="true">{% if block.settings[icon_key] == 'shipping' %}▱{% elsif block.settings[icon_key] == 'warranty' %}♢{% else %}＋{% endif %}</span>{% endif %}<span>{{ block.settings[label_key] }}</span></button>{% endfor %}</div>{% for i in (1..3) %}{% assign content_key = 'tab_' | append: i | append: '_content' %}<div id="ai-panel-{{ ai_gen_id }}-{{ i }}" class="ai-tabs-{{ ai_gen_id }}__panel" role="tabpanel" tabindex="0"{% unless i == 1 %} hidden{% endunless %}>{{ block.settings[content_key] }}</div>{% endfor %}</product-info-tabs-{{ ai_gen_id }}>
<script>(function(){class Tabs{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=[...this.querySelectorAll('[role=tab]')];this.p=[...this.querySelectorAll('[role=tabpanel]')];this.t.forEach((x,i)=>{x.addEventListener('click',()=>this.select(i));x.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();let n=e.key==='ArrowRight'?(i+1)%this.t.length:(i+this.t.length-1)%this.t.length;this.select(n)}})})}select(i){this.t.forEach((x,j)=>{x.setAttribute('aria-selected',j===i?'true':'false');x.tabIndex=j===i?0:-1;this.p[j].hidden=j!==i});this.t[i].focus()}}if(!customElements.get('product-info-tabs-{{ ai_gen_id }}'))customElements.define('product-info-tabs-{{ ai_gen_id }}',Tabs{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Product information tabs","settings":[{"type":"text","id":"tabs_label","label":"Accessibility label","default":"Product information"},{"type":"text","id":"tab_1_label","label":"Shipping tab","default":"Shipping"},{"type":"select","id":"tab_1_icon","label":"Shipping fallback icon","options":[{"value":"shipping","label":"Truck"},{"value":"warranty","label":"Shield"},{"value":"custom","label":"Plus"}],"default":"shipping"},{"type":"image_picker","id":"tab_1_image","label":"Shipping custom icon"},{"type":"richtext","id":"tab_1_content","label":"Shipping","default":"<p>Add shipping information here.</p>"},{"type":"text","id":"tab_2_label","label":"Warranty tab","default":"Warranty"},{"type":"select","id":"tab_2_icon","label":"Warranty fallback icon","options":[{"value":"shipping","label":"Truck"},{"value":"warranty","label":"Shield"},{"value":"custom","label":"Plus"}],"default":"warranty"},{"type":"image_picker","id":"tab_2_image","label":"Warranty custom icon"},{"type":"richtext","id":"tab_2_content","label":"Warranty","default":"<p>Add warranty information here.</p>"},{"type":"text","id":"tab_3_label","label":"Additional tab","default":"Details"},{"type":"select","id":"tab_3_icon","label":"Additional fallback icon","options":[{"value":"shipping","label":"Truck"},{"value":"warranty","label":"Shield"},{"value":"custom","label":"Plus"}],"default":"custom"},{"type":"image_picker","id":"tab_3_image","label":"Additional custom icon"},{"type":"richtext","id":"tab_3_content","label":"Additional content","default":"<p>Add additional product information here.</p>"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"body_font","label":"Body font","default":"sans-serif"},{"type":"range","id":"body_size","label":"Body size","min":12,"max":22,"step":1,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text","default":"#020202"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#4A4A4A"},{"type":"color","id":"accent_color","label":"Accent","default":"#334FB4"},{"type":"color","id":"border_color","label":"Borders","default":"#D9D9D9"}],"presets":[{"name":"Product information tabs"}],"tag":null,"class":"product-information-tabs-block"}{% endschema %}