{% doc %}
  @prompt
    make 3 tabs. When you click on each tab to show description below. I want to be able to edit text and description on each tab.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tabs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-tabs-{{ ai_gen_id }}__list {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    overflow-x: auto;
  }

  .ai-tabs-{{ ai_gen_id }}__tab {
    flex: 1 0 auto;
    min-width: 110px;
    padding: 14px 18px;
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: {{ block.settings.text_color }};
    font: inherit;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
  }

  .ai-tabs-{{ ai_gen_id }}__tab:hover,
  .ai-tabs-{{ ai_gen_id }}__tab:focus-visible {
    color: {{ block.settings.accent_color }};
  }

  .ai-tabs-{{ ai_gen_id }}__tab[aria-selected="true"] {
    border-bottom-color: {{ block.settings.accent_color }};
    color: {{ block.settings.accent_color }};
  }

  .ai-tabs-{{ ai_gen_id }}__panel {
    padding: 24px;
    line-height: 1.6;
  }

  .ai-tabs-{{ ai_gen_id }}__panel[hidden] {
    display: none;
  }

  .ai-tabs-{{ ai_gen_id }}__panel p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-tabs-{{ ai_gen_id }}__tab {
      padding: 12px 14px;
      min-width: 95px;
    }

    .ai-tabs-{{ ai_gen_id }}__panel {
      padding: 20px 16px;
    }
  }
{% endstyle %}

<product-info-tabs-{{ ai_gen_id }}
  class="ai-tabs-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-tabs-{{ ai_gen_id }}__list" role="tablist" aria-label="Product information">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'tab_' | append: i | append: '_title'
        assign title = block.settings[title_key]
      %}
      <button
        class="ai-tabs-{{ ai_gen_id }}__tab"
        id="ai-tab-{{ ai_gen_id }}-{{ i }}"
        type="button"
        role="tab"
        aria-controls="ai-panel-{{ ai_gen_id }}-{{ i }}"
        aria-selected="{% if i == 1 %}true{% else %}false{% endif %}"
        tabindex="{% if i == 1 %}0{% else %}-1{% endif %}"
      >
        {{ title | escape }}
      </button>
    {% endfor %}
  </div>

  {% for i in (1..3) %}
    {% liquid
      assign description_key = 'tab_' | append: i | append: '_description'
      assign description = block.settings[description_key]
    %}
    <div
      class="ai-tabs-{{ ai_gen_id }}__panel"
      id="ai-panel-{{ ai_gen_id }}-{{ i }}"
      role="tabpanel"
      aria-labelledby="ai-tab-{{ ai_gen_id }}-{{ i }}"
      {% if i != 1 %}hidden{% endif %}
    >
      {{ description }}
    </div>
  {% endfor %}
</product-info-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductInfoTabs{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
        this.panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
        this.tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => this.selectTab(index));
          tab.addEventListener('keydown', (event) => this.handleKeydown(event, index));
        });
      }

      selectTab(index) {
        this.tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === index;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.setAttribute('tabindex', active ? '0' : '-1');
        });
        this.panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== index;
        });
        this.tabs[index].focus();
      }

      handleKeydown(event, index) {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % this.tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + this.tabs.length) % this.tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = this.tabs.length - 1;
        if (nextIndex !== index) {
          event.preventDefault();
          this.selectTab(nextIndex);
        }
      }
    }

    if (!customElements.get('product-info-tabs-{{ ai_gen_id }}')) {
      customElements.define('product-info-tabs-{{ ai_gen_id }}', ProductInfoTabs{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Product info tabs",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "Title",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "tab_1_description",
      "label": "Description",
      "default": "<p>Add your product description here.</p>"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Title",
      "default": "Details"
    },
    {
      "type": "richtext",
      "id": "tab_2_description",
      "label": "Description",
      "default": "<p>Add product details here.</p>"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_title",
      "label": "Title",
      "default": "Shipping"
    },
    {
      "type": "richtext",
      "id": "tab_3_description",
      "label": "Description",
      "default": "<p>Add shipping information here.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D9D9D9"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Product info tabs"
    }
  ],
  "tag": null,
  "class": "product-info-tabs-block"
}
{% endschema %}