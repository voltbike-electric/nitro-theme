{% doc %}
  @prompt
    make FAQ section with title and collapsable qusetions with the answers revealed after clicking
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-faq-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.vertical_padding }}px 0;color:{{ block.settings.text_color }}}.ai-faq-{{ ai_gen_id }}__inner{max-width:900px;margin:0 auto}.ai-faq-{{ ai_gen_id }}__heading{margin:0 0 10px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.15;text-align:{{ block.settings.alignment }}}.ai-faq-{{ ai_gen_id }}__intro{margin:0 auto 28px;max-width:680px;color:{{ block.settings.text_color }};font-size:16px;line-height:1.6;text-align:{{ block.settings.alignment }}}.ai-faq-{{ ai_gen_id }}__list{border-top:1px solid {{ block.settings.border_color }}}.ai-faq-{{ ai_gen_id }}__item{border-bottom:1px solid {{ block.settings.border_color }}}.ai-faq-{{ ai_gen_id }}__question{display:flex;align-items:center;justify-content:space-between;gap:20px;width:100%;padding:21px 0;border:0;background:transparent;color:{{ block.settings.heading_color }};font:inherit;font-size:18px;font-weight:600;line-height:1.35;text-align:left;cursor:pointer}.ai-faq-{{ ai_gen_id }}__question:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:4px}.ai-faq-{{ ai_gen_id }}__icon{position:relative;flex:0 0 18px;width:18px;height:18px}.ai-faq-{{ ai_gen_id }}__icon:before,.ai-faq-{{ ai_gen_id }}__icon:after{content:"";position:absolute;top:50%;left:50%;width:18px;height:2px;background:{{ block.settings.heading_color }};transform:translate(-50%,-50%)}.ai-faq-{{ ai_gen_id }}__icon:after{transform:translate(-50%,-50%) rotate(90deg)}.ai-faq-{{ ai_gen_id }}__question[aria-expanded=true] .ai-faq-{{ ai_gen_id }}__icon:after{display:none}.ai-faq-{{ ai_gen_id }}__answer{padding:0 38px 22px 0;color:{{ block.settings.text_color }};font-size:16px;line-height:1.65}@media(max-width:749px){.ai-faq-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 0}.ai-faq-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times: 0.8 }}px}.ai-faq-{{ ai_gen_id }}__question{font-size:16px}}{% endstyle %}
<faq-accordion-{{ ai_gen_id }} class="ai-faq-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-faq-{{ ai_gen_id }}__inner">{% if block.settings.title != blank %}<h2 class="ai-faq-{{ ai_gen_id }}__heading">{{ block.settings.title | escape }}</h2>{% endif %}{% if block.settings.intro != blank %}<p class="ai-faq-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}<div class="ai-faq-{{ ai_gen_id }}__list">{% for i in (1..5) %}{% assign question_key = 'question_' | append: i %}{% assign answer_key = 'answer_' | append: i %}{% assign question = block.settings[question_key] %}{% assign answer = block.settings[answer_key] %}{% if question != blank and answer != blank %}<div class="ai-faq-{{ ai_gen_id }}__item"><button type="button" class="ai-faq-{{ ai_gen_id }}__question" aria-expanded="false" aria-controls="ai-faq-answer-{{ ai_gen_id }}-{{ i }}"><span>{{ question | escape }}</span><span class="ai-faq-{{ ai_gen_id }}__icon" aria-hidden="true"></span></button><div id="ai-faq-answer-{{ ai_gen_id }}-{{ i }}" class="ai-faq-{{ ai_gen_id }}__answer" hidden>{{ answer | newline_to_br }}</div></div>{% endif %}{% endfor %}</div></div></faq-accordion-{{ ai_gen_id }}>
<script>(function(){class FaqAccordion{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelectorAll('.ai-faq-{{ ai_gen_id }}__question').forEach((button)=>{button.addEventListener('click',()=>{const answer=this.querySelector('#'+button.getAttribute('aria-controls'));const expanded=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!expanded));answer.hidden=expanded})})}}if(!customElements.get('faq-accordion-{{ ai_gen_id }}'))customElements.define('faq-accordion-{{ ai_gen_id }}',FaqAccordion{{ ai_gen_id }})})();</script>
{% schema %}{"name":"FAQ accordion","settings":[{"type":"header","content":"Content"},{"type":"text","id":"title","label":"Title","default":"Frequently asked questions"},{"type":"textarea","id":"intro","label":"Intro","default":"Find answers to common questions about our products and service."},{"type":"text","id":"question_1","label":"Question 1","default":"What is included with my purchase?"},{"type":"textarea","id":"answer_1","label":"Answer 1","default":"Each product page lists the items included with your purchase, along with compatibility and installation details."},{"type":"text","id":"question_2","label":"Question 2","default":"How long does delivery take?"},{"type":"textarea","id":"answer_2","label":"Answer 2","default":"Delivery timing varies by destination and product availability. Current estimates are shown during checkout."},{"type":"text","id":"question_3","label":"Question 3","default":"What warranty coverage is available?"},{"type":"textarea","id":"answer_3","label":"Answer 3","default":"Warranty coverage depends on the product. Please review the warranty information on the relevant product page or contact our support team."},{"type":"text","id":"question_4","label":"Question 4","default":"Can I get help choosing the right product?"},{"type":"textarea","id":"answer_4","label":"Answer 4","default":"Contact our team with your requirements and intended use, and we will help you compare suitable options."},{"type":"text","id":"question_5","label":"Question 5","default":"How can I contact support?"},{"type":"textarea","id":"answer_5","label":"Answer 5","default":"Use the contact options on our website and include your order number when asking about an existing purchase."},{"type":"header","content":"Layout"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"vertical_padding","label":"Desktop spacing","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"mobile_padding","label":"Mobile spacing","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"heading_size","label":"Title size","min":20,"max":60,"step":2,"unit":"px","default":38},{"type":"header","content":"Colors"},{"type":"color","id":"heading_color","label":"Heading","default":"#020202"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},{"type":"color","id":"border_color","label":"Divider","default":"#D9D9D9"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#334FB4"}],"presets":[{"name":"FAQ accordion"}],"tag":null,"class":"faq-accordion-block"}{% endschema %}