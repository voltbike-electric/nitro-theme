{% doc %}
  @prompt
    Create a product comparison block for the Kodiak collection page that preserves the current comparison's content, appearance, and four existing rows, but supports eight comparison rows total. Add four additional rows with blank labels and blank values for both Kodiak and Kodiak V2, editable in the theme editor. Keep the comparison contained within the page width and responsive on smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-comparison-{{ ai_gen_id }}__table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .ai-comparison-{{ ai_gen_id }} th,
  .ai-comparison-{{ ai_gen_id }} td {
    padding: 16px 20px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    vertical-align: middle;
    text-align: left;
    line-height: 1.45;
  }

  .ai-comparison-{{ ai_gen_id }} thead th {
    padding-top: 20px;
    padding-bottom: 20px;
    background: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-weight: 700;
  }

  .ai-comparison-{{ ai_gen_id }} thead th:first-child {
    width: 40%;
  }

  .ai-comparison-{{ ai_gen_id }} thead th:not(:first-child) {
    width: 30%;
    text-align: center;
  }

  .ai-comparison-{{ ai_gen_id }} tbody tr:last-child td {
    border-bottom: 0;
  }

  .ai-comparison-{{ ai_gen_id }} tbody td:not(:first-child) {
    text-align: center;
  }

  .ai-comparison-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background: {{ block.settings.alternate_row_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__label {
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-{{ ai_gen_id }} th,
    .ai-comparison-{{ ai_gen_id }} td {
      padding: 13px 14px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="page-width ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-{{ ai_gen_id }}__scroll page-width">
    <table class="ai-comparison-{{ ai_gen_id }}__table">
      <thead>
        <tr>
          <th scope="col">{{ block.settings.feature_heading }}</th>
          <th scope="col">{{ block.settings.kodiak_heading }}</th>
          <th scope="col">{{ block.settings.kodiak_v2_heading }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..8) %}
          {% liquid
            assign label_key = 'row_' | append: i | append: '_label'
            assign kodiak_key = 'row_' | append: i | append: '_kodiak'
            assign kodiak_v2_key = 'row_' | append: i | append: '_kodiak_v2'
          %}
          <tr>
            <td class="ai-comparison-{{ ai_gen_id }}__label">{{ block.settings[label_key] }}</td>
            <td>{{ block.settings[kodiak_key] }}</td>
            <td>{{ block.settings[kodiak_v2_key] }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

