{% doc %}
  @prompt
    Make 4 columns images. Every image should have title and subtitle over it. The image and text should be replacable., make dark gradient at the bottom so the text is more visible.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-tiles-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-tiles-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-image-tiles-{{ ai_gen_id }}__tile {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 0;
    aspect-ratio: 3 / 4;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #e8e8e8;
    color: #ffffff;
    text-decoration: none;
    background: #121212;
  }

  .ai-image-tiles-{{ ai_gen_id }}__image,
  .ai-image-tiles-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 60%, rgba(0,0,0,0.2) 100%);
  mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0.1) 100%);
  }

  .ai-image-tiles-{{ ai_gen_id }}__image {
    object-fit: cover;
  }

  .ai-image-tiles-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-tiles-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 40%, rgba(0, 0, 0, 0.88) 100%);
    pointer-events: none;
  }

  .ai-image-tiles-{{ ai_gen_id }}__copy {
    position: absolute;
    right: 18px;
    bottom: 20px;
    left: 18px;
    z-index: 1;
    text-align: {{ block.settings.text_alignment }};
    color: #ffffff;
  }

  .ai-image-tiles-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.15;
    font-weight: 700;
    color: inherit;
  }

  .ai-image-tiles-{{ ai_gen_id }}__subtitle {
    margin: 0;
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.4;
    color: inherit;
  }

  .ai-image-tiles-{{ ai_gen_id }}__empty {
    position: absolute;
    inset: auto 10px 10px;
    z-index: 2;
    padding: 8px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-size: 12px;
    text-align: center;
  }

  .ai-image-tiles-{{ ai_gen_id }}__tile:focus-visible {
    outline: 3px solid #2979ff;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-tiles-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-image-tiles-{{ ai_gen_id }}__copy {
      right: 12px;
      bottom: 14px;
      left: 12px;
    }
  }
{% endstyle %}

<div class="ai-image-tiles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>

<div class="page-width">
<h2>Built Around Your Ride</h2>
<p>From daily commutes to weekend adventures, there’s a VoltBike built for your kind of ride. Choose your riding style, and we’ll take it from there.</p>
</div>

  <div class="page-width ai-image-tiles-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign subtitle_key = 'subtitle_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign subtitle = block.settings[subtitle_key]
        assign link = block.settings[link_key]
      %}
      {% if link != blank %}
        <a class="ai-image-tiles-{{ ai_gen_id }}__tile" href="{{ link }}" aria-label="{{ title | default: subtitle | escape }}">
      {% else %}
        <div class="ai-image-tiles-{{ ai_gen_id }}__tile">
      {% endif %}
        {% if image != blank %}
          <img class="ai-image-tiles-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-image-tiles-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
          <div class="ai-image-tiles-{{ ai_gen_id }}__empty">Add an image for tile {{ i }}</div>
        {% endif %}
        <div class="ai-image-tiles-{{ ai_gen_id }}__shade"></div>
        <div class="ai-image-tiles-{{ ai_gen_id }}__copy">
          {% if title != blank %}<h3 class="ai-image-tiles-{{ ai_gen_id }}__title">{{ title | escape }}</h3>{% endif %}
          {% if subtitle != blank %}<p class="ai-image-tiles-{{ ai_gen_id }}__subtitle">{{ subtitle | escape }}</p>{% endif %}
        </div>
      {% if link != blank %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Four image tiles",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "gap", "label": "Tile spacing", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 10 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Tile 1" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "title_1", "label": "Title", "default": "Tile one" },
    { "type": "text", "id": "subtitle_1", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_1", "label": "Link" },
    { "type": "header", "content": "Tile 2" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "title_2", "label": "Title", "default": "Tile two" },
    { "type": "text", "id": "subtitle_2", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_2", "label": "Link" },
    { "type": "header", "content": "Tile 3" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "title_3", "label": "Title", "default": "Tile three" },
    { "type": "text", "id": "subtitle_3", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_3", "label": "Link" },
    { "type": "header", "content": "Tile 4" },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "title_4", "label": "Title", "default": "Tile four" },
    { "type": "text", "id": "subtitle_4", "label": "Subtitle", "default": "Add a short description" },
    { "type": "url", "id": "link_4", "label": "Link" }
  ],
  "presets": [{ "name": "Four image tiles" }],
  "tag": null,
  "class": "four-image-tiles"
}
{% endschema %}