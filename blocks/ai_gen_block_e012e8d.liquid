{% doc %}
  @prompt
    Generate 1 row block with 4 image tiles. One big image tile one the left and the other 3 image tiles organized on the right. For the 3 image tiles make one image tile above and the 2 image tiles below. Each image tile should have text and button at the button. text should be replacable., Can you add subtitle option for each tile, Can you make the button customizable by color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-tiles-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-tiles-{{ ai_gen_id }}__layout { display: grid; grid-template-columns: 1fr 1fr; gap: {{ block.settings.tile_gap }}px; }
  .ai-image-tiles-{{ ai_gen_id }}__left, .ai-image-tiles-{{ ai_gen_id }}__right { min-width: 0; }
  .ai-image-tiles-{{ ai_gen_id }}__left { min-height: {{ block.settings.tile_height }}px; }
  .ai-image-tiles-{{ ai_gen_id }}__right { display: grid; grid-template-rows: 1fr 1fr; gap: {{ block.settings.tile_gap }}px; }
  .ai-image-tiles-{{ ai_gen_id }}__bottom-row { display: grid; grid-template-columns: 1fr 1fr; gap: {{ block.settings.tile_gap }}px; min-height: 0; }
  .ai-image-tiles-{{ ai_gen_id }}__tile { position: relative; display: flex; align-items: flex-end; overflow: hidden; min-height: 0; border-radius: {{ block.settings.corner_radius }}px; background: #e9e9e9; isolation: isolate; }
  .ai-image-tiles-{{ ai_gen_id }}__left .ai-image-tiles-{{ ai_gen_id }}__tile { height: 100%; }
  .ai-image-tiles-{{ ai_gen_id }}__right > .ai-image-tiles-{{ ai_gen_id }}__tile, .ai-image-tiles-{{ ai_gen_id }}__bottom-row .ai-image-tiles-{{ ai_gen_id }}__tile { min-height: calc(({{ block.settings.tile_height }}px - {{ block.settings.tile_gap }}px) / 2); }
  .ai-image-tiles-{{ ai_gen_id }}__image, .ai-image-tiles-{{ ai_gen_id }}__placeholder { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; }
  .ai-image-tiles-{{ ai_gen_id }}__image { object-fit: cover; }
  .ai-image-tiles-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; background: #e9e9e9; }
  .ai-image-tiles-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; color: #777; }
  .ai-image-tiles-{{ ai_gen_id }}__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,0,0,0) 20%, rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%); }
  .ai-image-tiles-{{ ai_gen_id }}__content { width: 100%; padding: {{ block.settings.content_padding }}px; color: #fff; }
  .ai-image-tiles-{{ ai_gen_id }}__heading { margin: 0 0 6px; color: inherit; font-size: clamp(18px, 2.4vw, {{ block.settings.heading_size }}px); line-height: 1.15; }
  .ai-image-tiles-{{ ai_gen_id }}__subtitle { margin: 0 0 12px; color: inherit; font-size: 15px; line-height: 1.4; }
  .ai-image-tiles-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 10px 18px; border: 1px solid {{ block.settings.button_background_color }}; border-radius: {{ block.settings.button_radius }}px; background: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }}; font-size: 14px; font-weight: 600; line-height: 1.2; text-decoration: none; }
  .ai-image-tiles-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #ffcc00; outline-offset: 3px; }

  @media screen and (max-width: 749px) {
    .ai-image-tiles-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; }
    .ai-image-tiles-{{ ai_gen_id }}__left .ai-image-tiles-{{ ai_gen_id }}__tile { min-height: {{ block.settings.tile_height | times: 0.75 }}px; }
    .ai-image-tiles-{{ ai_gen_id }}__right { grid-template-rows: auto auto; }
    .ai-image-tiles-{{ ai_gen_id }}__right > .ai-image-tiles-{{ ai_gen_id }}__tile, .ai-image-tiles-{{ ai_gen_id }}__bottom-row .ai-image-tiles-{{ ai_gen_id }}__tile { min-height: 190px; }
    .ai-image-tiles-{{ ai_gen_id }}__content { padding: 18px; }
  }
  @media screen and (max-width: 480px) { .ai-image-tiles-{{ ai_gen_id }}__bottom-row { grid-template-columns: 1fr; } }
{% endstyle %}

<div class="ai-image-tiles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="page-width ai-image-tiles-{{ ai_gen_id }}__layout">
    <div class="ai-image-tiles-{{ ai_gen_id }}__left">
      <div class="ai-image-tiles-{{ ai_gen_id }}__tile">
      {% if block.settings.button_label_1 != blank and block.settings.button_link_1 != blank %}
      <a href="{{ block.settings.button_link_1 }}" style="text-decoration: none;">
      {% endif %}

      {% if block.settings.image_1 != blank %}<img class="ai-image-tiles-{{ ai_gen_id }}__image" src="{{ block.settings.image_1 | image_url: width: 1400 }}" alt="{{ block.settings.image_1.alt | escape }}" loading="lazy" width="{{ block.settings.image_1.width }}" height="{{ block.settings.image_1.height }}">{% else %}<div class="ai-image-tiles-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}       
        <div class="ai-image-tiles-{{ ai_gen_id }}__shade"></div>
        <div class="ai-image-tiles-{{ ai_gen_id }}__content">
          {% if block.settings.heading_1 != blank %}<h2 class="ai-image-tiles-{{ ai_gen_id }}__heading">{{ block.settings.heading_1 | escape }}</h2>{% endif %}
          {% if block.settings.subtitle_1 != blank %}<p class="ai-image-tiles-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle_1 | escape }}</p>{% endif %}
          {% if block.settings.button_label_1 != blank and block.settings.button_link_1 != blank %}<div class="ai-image-tiles-{{ ai_gen_id }}__button">{{ block.settings.button_label_1 | escape }}</div>{% endif %}
        </div>
        {% if block.settings.button_label_1 != blank and block.settings.button_link_1 != blank %}
        </a>
        {% endif %}
      </div>
    </div>
    <div class="ai-image-tiles-{{ ai_gen_id }}__right">
      <div class="ai-image-tiles-{{ ai_gen_id }}__tile">
        {% if block.settings.image_2 != blank %}<img class="ai-image-tiles-{{ ai_gen_id }}__image" src="{{ block.settings.image_2 | image_url: width: 1200 }}" alt="{{ block.settings.image_2.alt | escape }}" loading="lazy" width="{{ block.settings.image_2.width }}" height="{{ block.settings.image_2.height }}">{% else %}<div class="ai-image-tiles-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
        <div class="ai-image-tiles-{{ ai_gen_id }}__shade"></div>
        <div class="ai-image-tiles-{{ ai_gen_id }}__content">
          {% if block.settings.heading_2 != blank %}<h2 class="ai-image-tiles-{{ ai_gen_id }}__heading">{{ block.settings.heading_2 | escape }}</h2>{% endif %}
          {% if block.settings.subtitle_2 != blank %}<p class="ai-image-tiles-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle_2 | escape }}</p>{% endif %}
          {% if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank %}<a class="ai-image-tiles-{{ ai_gen_id }}__button" href="{{ block.settings.button_link_2 }}">{{ block.settings.button_label_2 | escape }}</a>{% endif %}
        </div>
      </div>
      <div class="ai-image-tiles-{{ ai_gen_id }}__bottom-row">
        <div class="ai-image-tiles-{{ ai_gen_id }}__tile">
          {% if block.settings.image_3 != blank %}<img class="ai-image-tiles-{{ ai_gen_id }}__image" src="{{ block.settings.image_3 | image_url: width: 900 }}" alt="{{ block.settings.image_3.alt | escape }}" loading="lazy" width="{{ block.settings.image_3.width }}" height="{{ block.settings.image_3.height }}">{% else %}<div class="ai-image-tiles-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
          <div class="ai-image-tiles-{{ ai_gen_id }}__shade"></div>
          <div class="ai-image-tiles-{{ ai_gen_id }}__content">
            {% if block.settings.heading_3 != blank %}<h2 class="ai-image-tiles-{{ ai_gen_id }}__heading">{{ block.settings.heading_3 | escape }}</h2>{% endif %}
            {% if block.settings.subtitle_3 != blank %}<p class="ai-image-tiles-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle_3 | escape }}</p>{% endif %}
            {% if block.settings.button_label_3 != blank and block.settings.button_link_3 != blank %}<a class="ai-image-tiles-{{ ai_gen_id }}__button" href="{{ block.settings.button_link_3 }}">{{ block.settings.button_label_3 | escape }}</a>{% endif %}
          </div>
        </div>
        <div class="ai-image-tiles-{{ ai_gen_id }}__tile">
          {% if block.settings.image_4 != blank %}<img class="ai-image-tiles-{{ ai_gen_id }}__image" src="{{ block.settings.image_4 | image_url: width: 900 }}" alt="{{ block.settings.image_4.alt | escape }}" loading="lazy" width="{{ block.settings.image_4.width }}" height="{{ block.settings.image_4.height }}">{% else %}<div class="ai-image-tiles-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
          <div class="ai-image-tiles-{{ ai_gen_id }}__shade"></div>
          <div class="ai-image-tiles-{{ ai_gen_id }}__content">
            {% if block.settings.heading_4 != blank %}<h2 class="ai-image-tiles-{{ ai_gen_id }}__heading">{{ block.settings.heading_4 | escape }}</h2>{% endif %}
            {% if block.settings.subtitle_4 != blank %}<p class="ai-image-tiles-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle_4 | escape }}</p>{% endif %}
            {% if block.settings.button_label_4 != blank and block.settings.button_link_4 != blank %}<a class="ai-image-tiles-{{ ai_gen_id }}__button" href="{{ block.settings.button_link_4 }}">{{ block.settings.button_label_4 | escape }}</a>{% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Four image tiles",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "tile_height", "label": "Row height", "min": 300, "max": 800, "step": 50, "unit": "px", "default": 500 },
    { "type": "range", "id": "tile_gap", "label": "Tile spacing", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "content_padding", "label": "Text padding", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "button_background_color", "label": "Button color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#111111" },
    { "type": "header", "content": "Large tile" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "heading_1", "label": "Text", "default": "Explore the collection" },
    { "type": "text", "id": "subtitle_1", "label": "Subtitle", "default": "Discover gear for your next ride" },
    { "type": "text", "id": "button_label_1", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link_1", "label": "Button link" },
    { "type": "header", "content": "Top right tile" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "heading_2", "label": "Text", "default": "Find your next upgrade" },
    { "type": "text", "id": "subtitle_2", "label": "Subtitle", "default": "Parts to make every ride better" },
    { "type": "text", "id": "button_label_2", "label": "Button label", "default": "Discover" },
    { "type": "url", "id": "button_link_2", "label": "Button link" },
    { "type": "header", "content": "Bottom left tile" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "heading_3", "label": "Text", "default": "Built for the ride" },
    { "type": "text", "id": "subtitle_3", "label": "Subtitle", "default": "Comfort and control on every route" },
    { "type": "text", "id": "button_label_3", "label": "Button label", "default": "View gear" },
    { "type": "url", "id": "button_link_3", "label": "Button link" },
    { "type": "header", "content": "Bottom right tile" },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "heading_4", "label": "Text", "default": "Ready for every route" },
    { "type": "text", "id": "subtitle_4", "label": "Subtitle", "default": "Equip yourself for the journey ahead" },
    { "type": "text", "id": "button_label_4", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "button_link_4", "label": "Button link" }
  ],
  "presets": [{ "name": "Four image tiles" }],
  "tag": null,
  "class": "four-image-tiles-block"
}
{% endschema %}